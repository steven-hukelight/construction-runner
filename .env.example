# Option 1: Use Supabase API (requires firebase_staging in Dashboard > API > Exposed schemas)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Public web app URL (canonical www) — auth redirectTo, emails, metadata. Must match Supabase Auth redirect allowlist.
# NEXT_PUBLIC_SITE_URL=https://www.construction-runner.com
# NEXT_PUBLIC_BASE_URL=https://www.construction-runner.com
# NEXTAUTH_URL=https://www.construction-runner.com
# SUPABASE_SITE_URL=https://www.construction-runner.com
# SUPABASE_REDIRECT_URL=https://www.construction-runner.com/auth/callback

# Option 2: Use direct Postgres (recommended - avoids API schema setup)
# Get from Supabase Dashboard > Project Settings > Database > Connection string > URI
# DATABASE_URL=postgresql://postgres.[ref]:[YOUR-PASSWORD]@aws-0-xx.pooler.supabase.com:6543/postgres
