{
  "version": 2,
  "redirects": [
    {
      "source": "/(.*)",
      "destination": "https://www.construction-runner.com/$1",
      "permanent": true,
      "has": [{ "type": "host", "value": "construction-runner.com" }]
    }
  ],
  "headers": [
    {
      "source": "/_next/static/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/fonts/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "no-store" }]
    }
  ],
  "crons": [
    {
      "path": "/api/maintenance/retention-cleanup",
      "schedule": "0 3 * * 0"
    },
    { "path": "/api/attendance/archive", "schedule": "0 0 * * *" },
    { "path": "/api/attendance/archive", "schedule": "0 23 * * *" },
    {
      "path": "/api/maintenance/dispatch-attendance-push-queue",
      "schedule": "15 3 * * *"
    },
    {
      "path": "/api/maintenance/dispatch-asset-inspection-reminders",
      "schedule": "0 7 * * *"
    },
    {
      "path": "/api/maintenance/dispatch-face-fit-reminders",
      "schedule": "10 7 * * *"
    }
  ]
}
