{
  "name": "construction-runner-admin",
  "version": "1.0.0",
  "description": "Construction Runner Admin - Supabase only",
  "main": "index.js",
  "scripts": {
    "dev": "next dev",
    "dev:mobile": "next dev -H 0.0.0.0",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "test": "jest",
    "test:unit": "jest",
    "test:e2e": "jest --testPathPattern=e2e",
    "test:rls": "jest --runInBand tests/rls/users.rls.test.ts tests/rls/sites.rls.test.ts tests/rls/tasks.rls.test.ts tests/rls/notices.rls.test.ts tests/rls/deliveries.rls.test.ts",
    "test:regression": "jest -c jest.regression.config.js",
    "test:integration": "jest -c jest.integration.config.js",
    "test:performance": "jest -c jest.performance.config.js",
    "test:web:performance": "playwright test tests/performance/web.performance.spec.ts",
    "test:snapshots": "jest tests/snapshots/ --passWithNoTests",
    "update-snapshots": "jest tests/snapshots/ -u",
    "check:uuids": "npx tsx scripts/check-uuids.ts",
    "validate:schema": "npx tsx scripts/validate-schema.ts",
    "drift-audit": "node ../scripts/drift-audit.mjs --schema-file=scripts/supabase-schema.json"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.0.0",
    "@tailwindcss/postcss": "^4.1.18",
    "autoprefixer": "^10.4.24",
    "clsx": "^2.1.1",
    "framer-motion": "^12.34.0",
    "jspdf": "^4.1.0",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.564.0",
    "next": "16.1.6",
    "next-auth": "^4.24.13",
    "nodemailer": "^7.0.13",
    "postcss": "^8.5.6",
    "react": "^18.0.0",
    "react-dom": "^18.0.0",
    "react-hot-toast": "^2.6.0",
    "recharts": "^3.7.0",
    "swr": "^2.3.0",
    "tailwind-merge": "^3.4.0",
    "tailwindcss": "^4.1.18"
  },
  "overrides": {
    "next": "16.1.6"
  },
  "devDependencies": {
    "undici": "^7.0.0",
    "@playwright/test": "^1.58.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/pg": "^8.16.0",
    "@types/react": "19.2.14",
    "dotenv": "^17.3.1",
    "eslint": "^9.39.2",
    "eslint-config-next": "16.1.6",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "node-fetch": "^2.7.0",
    "pg": "^8.18.0",
    "ts-jest": "^29.1.1",
    "typescript": "^5.0.0",
    "zod": "^4.3.6"
  }
}
